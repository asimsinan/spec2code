{
  "id": "sdd-tasks-atomic-v9",
  "name": "SDD Atomic Tasks Template (Framework-Agnostic RED-GREEN-REFACTOR-SMOKE)",
  "version": "9.4.0",
  "description": "Framework-agnostic atomic task-based SDD with sequential tasks across four phases and mandatory verification. Each task requires proof of execution to prevent AI from gaming the system. CRITICAL: When tasks have multiple requirements (using 'AND', 'INCLUDE', 'ENSURE'), the AI MUST implement ALL requirements, not just the first one. Verify ALL acceptance criteria are met.",
  "template_data": {
    "metadata": {
      "generated": "{{CURRENT_DATE}}",
      "status": "Draft",
      "phaseProfile": "4-phase-atomic-verified-framework-agnostic",
      "tddOrder": "RED → GREEN → REFACTOR → SMOKE",
      "totalTasks": 33,
      "phase1Tasks": 9,
      "phase2Tasks": 8,
      "phase3Tasks": 9,
      "phase4Tasks": 7,
      "verificationType": "mandatory-proof-execution",
      "antiGamingEnforcement": "enabled",
      "timeoutConfiguration": {
        "unitTests": "60s",
        "integrationTests": "90s",
        "fullTestSuite": "120s",
        "coverageTests": "120s",
        "buildProcess": "60s",
        "startupProcess": "30s",
        "rationale": "Prevent AI hanging on long-running tests and processes",
        "implementation": "Uses 'timeout' command with bash -c wrapper for better process control",
        "fallback": "If timeout fails, use '{{TEST_COMMAND}} &' with 'sleep X && pkill -f {{TEST_PROCESS_NAME}}' as backup",
        "helperScript": "timeout-helper.sh provides robust timeout with multiple fallback methods",
        "alternativeMethods": [
          "timeout 60s bash -c '{{TEST_COMMAND}}'",
          "./timeout-helper.sh 60s '{{TEST_COMMAND}}'",
          "{{TEST_COMMAND}} & sleep 60 && pkill -f {{TEST_PROCESS_NAME}}"
        ]
      },
      "actionVerbs": [
        "EXECUTE",
        "RUN",
        "COMPILE",
        "SHOW",
        "CONFIRM",
        "CREATE",
        "IMPLEMENT",
        "GENERATE",
        "DOCUMENT",
        "CONFIGURE",
        "SETUP",
        "DEFINE",
        "WRITE"
      ],
      "description": "Atomic structure with mandatory verification across four phases",
      "commandPlaceholders": {
        "description": "Platform-agnostic command placeholders that AI must replace with platform-specific commands based on detected platform and framework",
        "placeholders": {
          "{{BUILD_COMMAND}}": "Platform-specific build/compile command (e.g., 'npm run build', 'python -m py_compile src/**/*.py', 'mvn compile', 'dotnet build')",
          "{{TEST_COMMAND}}": "Platform-specific test execution command (e.g., 'npm test', 'python -m pytest tests/', 'mvn test', 'dotnet test')",
          "{{TEST_COVERAGE_COMMAND}}": "Platform-specific test coverage command (e.g., 'npm run test:coverage', 'pytest --cov=src tests/')",
          "{{PRODUCTION_BUILD_COMMAND}}": "Platform-specific production build command (e.g., 'npm run build --prod', 'next build', 'ng build --prod')",
          "{{PERFORMANCE_BENCHMARK_COMMAND}}": "Platform-specific performance benchmarking command",
          "{{DIRECTORY_LIST_COMMAND}}": "Platform-specific directory listing command (e.g., 'find . -type d -name \"src\" -o -name \"tests\" | sort', 'tree -L 3 || ls -la')",
          "{{FILE_STRUCTURE_COMMAND}}": "Platform-specific file structure display command (e.g., 'tree -L 3 || ls -la', 'find . -name \"*.js\" -o -name \"*.py\" | head -20')",
          "{{PLATFORM_VERSION_COMMAND}}": "Platform-specific version check command (e.g., 'node --version && npm --version', 'python --version && pip --version')",
          "{{DEPENDENCY_INSTALL_COMMAND}}": "Platform-specific dependency installation command (e.g., 'npm install', 'pip install -r requirements.txt', 'dotnet restore')",
          "{{DEPENDENCY_LIST_COMMAND}}": "Platform-specific dependency listing command (e.g., 'npm list --depth=0', 'pip list', 'dotnet list package')",
          "{{TEST_PROCESS_NAME}}": "Process name for test command used in timeout killing (e.g., 'npm', 'python', 'mvn')",
          "{{START_SERVER_COMMAND}}": "Platform-specific server start command (e.g., 'npm start', 'python app.py', 'mvn spring-boot:run', 'dotnet run')"
        },
        "replacementRules": {
          "mandatory": true,
          "validation": "AI must replace ALL placeholders with actual platform-specific commands",
          "platformDetection": "Commands must match the detected platform (web, mobile, backend, desktop, ai)",
          "frameworkMatch": "Commands must be appropriate for the detected framework (React, Vue, Angular, Express, Django, etc.)",
          "noMixing": "FORBIDDEN to include commands from other platforms - only commands for the detected platform",
          "executable": "All replaced commands must be executable shell commands, not pseudo-code"
        }
      },
      "continuousExecutionPolicy": {
        "enabled": true,
        "mandatory": true,
        "rules": [
          "Complete ALL tasks in the current phase without stopping",
          "Never ask for permission to continue between tasks",
          "Never pause to show progress or summarize mid-phase",
          "Move automatically from task to task without interruption",
          "Only stop when ALL tasks in the phase are complete and verified",
          "Do not ask user to say 'proceed' or 'continue'",
          "Execute tasks in continuous, uninterrupted session"
        ],
        "prohibitedActions": [
          "Asking for permission to continue",
          "Pausing between tasks",
          "Stopping to show progress",
          "Summarizing mid-phase",
          "Requesting user input",
          "Saying 'proceed' or 'continue'"
        ],
        "enforcementLevel": "critical",
        "violationConsequences": "Task execution must restart from beginning of phase",
        "antiEvasionRules": [
          "Never mention 'limited time' or 'time constraints'",
          "Never skip tasks due to complexity or difficulty",
          "Never accept partial completion or 'good enough' solutions",
          "Never skip tests because they are failing or problematic",
          "Never work around issues - always fix them completely",
          "Never provide summaries instead of actual implementation",
          "Never treat status updates as task completion",
          "Never implement only the first requirement when multiple are listed (AND, INCLUDE, ENSURE)",
          "Never stop at structure/creation without implementing all requirements",
          "Verify ALL acceptance criteria before marking task complete"
        ]
      }
    },
    "taskPhases": {
      "phase1": {
        "title": "Phase 1: Project Setup & Foundations (9 tasks)",
        "description": "Project initialization, configuration, contract definition, and foundation implementation with atomic verification. Each task uses action verbs and requires proof. Includes REFACTOR phase for architectural review. 🚨 CRITICAL: Complete ALL 9 tasks in this phase without stopping - do not ask for permission to continue! When a task description contains multiple requirements (AND, INCLUDE, ENSURE), you MUST implement ALL requirements, not just the first one. Verify ALL acceptance criteria before marking a task complete.\n\n🚨🚨🚨 CRITICAL PHASE 1 CLARIFICATION 🚨🚨🚨\nPhase 1 contains BOTH design/specification tasks AND implementation tasks:\n- Tasks 1-2: Design, setup, specifications, and preparation\n- Tasks 3-5: ACTUAL CODE IMPLEMENTATION (not just design!)\n- Tasks 6-9: Final verification and testing\n\nDO NOT confuse design with implementation!\n- API specifications (TASK-001) = DESIGN, not implementation\n- Data schemas (TASK-001) = DESIGN, not implementation\n- API endpoints (TASK-003) = ACTUAL CODE IMPLEMENTATION!\n\nPhase 1 is NOT complete until you have WORKING, FUNCTIONAL code - not just specifications and designs!",
        "taskCount": 9,
        "tasks": [
          {
            "id": "TASK-001",
            "title": "[TASK-001] ESTABLISH Foundation & Design: Project Setup + API Contracts & Database Schema",
            "tddPhase": "Setup",
            "subPhase": "Foundation_Configuration",
            "dependencies": [],
            "description": "CONFIGURE project directory structure with proper organization AND SETUP development environment with all necessary tools, frameworks, and dependencies AND CONFIGURE environment variables for development, testing, and production environments AND CREATE OpenAPI 3.0 specification file with complete API definition AND CHOOSE and SETUP database engine AND DEFINE complete database schema. SHOW complete directory tree, successful dependency installation, API spec validation, and database schema creation. MANDATORY: Complete ALL 6 components - structure, environment, configuration, API contracts, database engine, and schema!",
            "acceptanceCriteria": "Project structure created + development environment configured + environment variables set + all tools/frameworks/dependencies installed + OpenAPI specification created + validation passes + database engine chosen + schema defined with all tables/relationships/constraints + API definition complete. Verify ALL 9 requirements before marking complete!",
            "estimatedLOC": "320-650",
            "estimatedDuration": "135min",
            "verification": {
              "type": "foundation_design_confirmation",
              "mandatory": true,
              "action": "SHOW",
              "commands": [
                "{{DIRECTORY_LIST_COMMAND}}",
                "{{FILE_STRUCTURE_COMMAND}}",
                "{{PLATFORM_VERSION_COMMAND}}",
                "{{DEPENDENCY_INSTALL_COMMAND}} && {{DEPENDENCY_LIST_COMMAND}}",
                "show environment variables",
                "validate OpenAPI specification",
                "show validation results",
                "confirm API spec completeness",
                "show database engine choice",
                "show created database schema",
                "list all tables and relationships",
                "CRITICAL: Verify ALL requirements from description are implemented (structure + environment + configuration + API + database design)"
              ],
              "expectedState": "Project foundation and design complete with structure, environment, configuration, API contracts, and database schema all operational. MANDATORY: All requirements from description must be verified.",
              "proofRequired": {
                "format": "terminal_output_and_files",
                "mustInclude": [
                  "src",
                  "tests",
                  "docs",
                  "config",
                  "dependencies",
                  "installed",
                  "environment",
                  "variables",
                  "validation",
                  "passed",
                  "openapi",
                  "specification",
                  "database",
                  "engine",
                  "schema",
                  "tables",
                  "relationships",
                  "VERIFIED: All foundation and design requirements implemented"
                ]
              },
              "postVerificationInstructions": {
                "onSuccess": "🚨 CRITICAL: TASK-001 verification complete! Proceed immediately to TASK-002 without stopping or asking for permission!",
                "onFailure": "🚨 CRITICAL: TASK-001 verification failed! ALL requirements must be implemented (structure + environment + configuration + API + database design). Fix ALL missing requirements and re-verify, then proceed immediately to TASK-002!",
                "enforcement": "mandatory",
                "noPause": true,
                "nextTask": "TASK-002"
              }
            },
            "constitutionalCompliance": "✅ Foundation & Design Gate",
            "parallelizable": false
          },
          {
            "id": "TASK-002",
